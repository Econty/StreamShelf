{
  "manifest_version": 3,
  "name": "StreamShelf Connector",
  "version": "1.0.2",
  "description": "Связь Firefox со StreamShelf: поиск медиа на открытой странице и передача данных локальной программе.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "256": "icons/icon-256.png"
  },
  "permissions": [
    "nativeMessaging",
    "alarms",
    "cookies",
    "webRequest",
    "storage",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "StreamShelf",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "connector@streamshelf.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "authenticationInfo"
        ]
      }
    }
  }
}
